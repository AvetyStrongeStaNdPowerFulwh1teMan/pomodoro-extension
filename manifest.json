{
  "manifest_version": 3,
  "name": "Pomodoro Timer",
  "version": "0.1.0",
  "description": "Pomodoro timer with productivity calendar and end-of-phase sound.",
  "icons": {
    "16": "icons/tomato-16.png",
    "32": "icons/tomato-32.png",
    "48": "icons/tomato-48.png",
    "128": "icons/tomato-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pomodoro Timer",
    "default_icon": {
      "16": "icons/tomato-16.png",
      "32": "icons/tomato-32.png",
      "48": "icons/tomato-48.png",
      "128": "icons/tomato-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "offscreen",
    "storage"
  ]
}
